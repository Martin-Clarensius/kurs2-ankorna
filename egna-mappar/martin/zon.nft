table inet zon
delete table inet zon

table inet zon {
    chain in {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        ip saddr 172.20.1.2 tcp dport 22 accept comment "D1 SSH fran jump"
        ip saddr 172.20.1.10 tcp dport 22 accept comment "D2 kontroll fran ctf"
        ip saddr 10.40.2.96/28 tcp dport 22 accept comment "F6 SSH fran Management"
        ip saddr { 10.40.2.0/27, 10.40.2.32/27, 10.40.2.64/28 } tcp dport 514 accept comment "F4 logg fran Webb App DB"
        limit rate 10/minute burst 5 packets log prefix "ZON-IN-DROP " level info
    }

    chain ut {
        type filter hook output priority filter; policy drop;
        ct state established,related accept
        oif "lo" accept
        ip daddr { 185.12.64.1, 185.12.64.2 } meta l4proto { tcp, udp } th dport 53 accept comment "D3 DNS"
        ip daddr 172.20.1.58 tcp dport 514 accept comment "D5 logg till log"
        ip daddr 172.20.1.58 tcp dport 6514 accept comment "F4 logg till log (TLS)"
        udp sport 68 udp dport 67 accept comment "D6 DHCP-fornyelse"
        udp dport 123 accept comment "D4 NTP"
        tcp dport 443 accept comment "D7 uppdateringar"
        limit rate 10/minute burst 5 packets log prefix "ZON-UT-DROP " level info
    }
}