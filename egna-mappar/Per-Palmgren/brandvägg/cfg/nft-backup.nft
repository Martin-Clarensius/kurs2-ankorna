#!/usr/sbin/nft -f
flush ruleset

# ---------- Zondefinitioner ----------
define GW                = 10.40.2.1
define JUMP              = 172.20.1.2
define CTF               = 172.20.1.10
define LoggServ_IP       = 172.20.1.58
define MIN_IP            = 10.40.2.99

define WebServ           = 10.40.2.0/27
define AppServ           = 10.40.2.32/27
define DataServ          = 10.40.2.64/28
define LoggServ          = 10.40.2.80/28
define AdminServ         = 10.40.2.96/28

table inet zon {

    chain in {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iif "lo" accept

        # D1/D2: SSH från jump/CTF till management
        ip saddr $JUMP tcp dport 22 accept comment "D1 SSH från jump"
        ip saddr $CTF  tcp dport 22 accept comment "D2 Kontroll från ctf"

        # D6: DHCP-svar från servrar
        iifname { "eth0", "eth1", "eth2" } udp sport 67 udp dport 68 accept comment "D6 DHCP-svar"

        limit rate 10/minute log prefix "ZON-IN-DROP " level info
    }

    chain ut {
        type filter hook output priority 0; policy drop;

        ct state established,related accept
        oif "lo" accept

        # F6: Management -> godkända servrar, TCP 22
        ip daddr { $WebServ, $AppServ, $DataServ, $LoggServ } tcp dport 22 accept comment "F6 SSH till godkända servrar"

        # D3: DNS
        ip daddr { 185.12.64.1, 185.12.64.2 } meta l4proto { tcp, udp } th dport 53 accept comment "D3 DNS"

        # D4: NTP
        oifname "eth0" udp dport 123 accept comment "D4 NTP chrony"

        # D6: DHCP-klient, broadcast och unicast
        oifname { "eth0", "eth1", "eth2" } udp sport 68 udp dport 67 accept comment "D6 DHCP-klient"

        # D7: HTTPS för paketuppdateringar
        oifname "eth0" tcp dport 443 accept comment "D7 paketuppdateringar dnf"

        # D5: loggning över TLS
        ip daddr $LoggServ_IP tcp dport 6514 accept comment "D5 Logg till loggserver TLS"

        limit rate 10/minute log prefix "ZON-UT-DROP " level info
    }
}
